---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Privacy Policy";
const description = "Privacy Policy for ClearTechExplained.";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="container">
      <h1>Privacy Policy</h1>

      <p>
        This Privacy Policy explains how we collect, use, and protect your information when you visit this website.
      </p>

      <h2>Information We Collect</h2>
      <p>
        We may collect basic usage data such as pages visited, time spent on site, and browser type.
      </p>

      <h2>How We Use Information</h2>
      <p>
        We use this information to improve content, user experience, and website performance.
      </p>

      <h2>Cookies</h2>
      <p>
        This website may use cookies to enhance browsing experience and support analytics.
      </p>

      <h2>Third Party Services</h2>
      <p>
        We may use third party tools such as analytics or advertising platforms that collect anonymous usage data.
      </p>

      <h2>Contact</h2>
      <p>
        If you have questions about this Privacy Policy, contact us via the Contact page.
      </p>
    </main>

    <Footer />
  </body>
</html>