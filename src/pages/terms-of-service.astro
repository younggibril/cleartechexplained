---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Terms of Service";
const description = "Terms of Service for ClearTechExplained.";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="container">
      <h1>Terms of Service</h1>

      <p>
        By using this website, you agree to the following terms and conditions.
      </p>

      <h2>Use of Content</h2>
      <p>
        All content is for informational purposes only. You may not copy or redistribute content without permission.
      </p>

      <h2>User Responsibility</h2>
      <p>
        Users are responsible for how they use the information provided on this website.
      </p>

      <h2>Limitation of Liability</h2>
      <p>
        We are not responsible for any losses or damages resulting from the use of this website.
      </p>

      <h2>Changes to Terms</h2>
      <p>
        These terms may be updated at any time without prior notice.
      </p>
    </main>

    <Footer />
  </body>
</html>